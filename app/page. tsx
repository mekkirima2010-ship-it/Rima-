function StatCard({ icon: Icon, value, label, color }: { icon: typeof Flame; value: string; label: string; color: string }) {
  const colors = { orange: 'bg-orange-400/15 text-orange-300', cyan: 'bg-cyan-400/15 text-cyan-300', violet: 'bg-violet-400/15 text-violet-300' }
  return <div className="rounded-2xl border border-white/[0.08] bg-white/[0.035] p-4"><div className={`mb-3 grid size-9 place-items-center rounded-xl ${colors[color as keyof typeof colors]}`}><Icon className="size-4" /></div><p className="text-xl font-black text-white">{value}</p><p className="mt-1 text-[11px] text-slate-500">{label}</p></div>
}

function SubjectCard({ subject }: { subject: Subject }) {
  const style = accentStyles[subject.accent]
  return <article className="group rounded-[22px] border border-white/[0.08] bg-white/[0.035] p-4 transition hover:-translate-y-1 hover:border-white/20"><div className="mb-5 flex items-start justify-between"><div className={`grid size-11 place-items-center rounded-2xl ${style.icon}`}><subject.icon className="size-5" /></div><button aria-label={`خيارات ${subject.name}`} className="text-slate-600 hover:text-white"><MoreHorizontal className="size-5" /></button></div><h3 className="mb-1 text-sm font-black text-white">{subject.name}</h3><p className="mb-5 text-[11px] text-slate-500">{subject.description}</p><div className="mb-2 flex items-center justify-between text-[11px]"><span className="text-slate-500">{subject.lessons}</span><strong className="text-slate-300">{subject.progress}%</strong></div><div className="mb-4 h-1.5 overflow-hidden rounded-full bg-white/10"><div className={`h-full rounded-full ${style.bar}`} style={{ width: `${subject.progress}%` }} /></div><button className="flex w-full items-center justify-center gap-2 rounded-xl bg-white/[0.06] py-2.5 text-xs font-bold text-slate-300 transition group-hover:bg-violet-500/15 group-hover:text-violet-200"><Play className="size-3 fill-current" /> متابعة الدرس</button></article>
